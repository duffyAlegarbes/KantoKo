@inject CartStateService CartState

<div class="group bg-white rounded-2xl p-4 border border-kanto-cream-200/90 shadow-soft-card hover:shadow-elevated transition-all duration-300 flex flex-col justify-between relative">
    
    <div>
        <!-- Top Visual Frame -->
        <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-kanto-cream-100 mb-3.5">
            
            <!-- Badge Pill (New / Bestseller) -->
            @if (!string.IsNullOrEmpty(Product.BadgeText))
            {
                <span class="absolute top-3 left-3 z-10 bg-kanto-green-900 text-white text-[10px] font-black tracking-wider uppercase px-2.5 py-1 rounded-md shadow-sm">
                    @Product.BadgeText
                </span>
            }

            <!-- Wishlist Heart Button -->
            <button @onclick="ToggleWishlist" 
                    @onclick:stopPropagation="true"
                    class="absolute top-3 right-3 z-10 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center text-kanto-charcoal hover:text-kanto-orange-500 shadow-sm transition-colors"
                    aria-label="Wishlist">
                <svg class="w-4 h-4 @(IsFavorited ? "fill-kanto-orange-500 text-kanto-orange-500" : "fill-none text-kanto-charcoal")" 
                     stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
            </button>

            <!-- Product Picture -->
            <img src="@Product.ImageUrl" 
                 alt="@Product.Name" 
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>

        <!-- Vendor Origin Tag -->
        <div class="flex items-center gap-1.5 text-[11px] font-semibold text-kanto-muted mb-1">
            <svg class="w-3 h-3 text-kanto-orange-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12z" clip-rule="evenodd"/>
            </svg>
            <span class="truncate">@Product.VendorName</span>
        </div>

        <!-- Title -->
        <h4 class="font-bold text-sm sm:text-base text-kanto-charcoal group-hover:text-kanto-orange-500 transition-colors line-clamp-1">
            @Product.Name
        </h4>
        <p class="text-xs text-kanto-muted mt-0.5 line-clamp-2">
            @Product.Description
        </p>
    </div>

    <!-- Bottom Row: Price & Add to Cart -->
    <div class="mt-4 pt-3 border-t border-kanto-cream-100 flex items-center justify-between">
        <div>
            <span class="text-lg font-black text-kanto-charcoal">
                ₱@Product.Price.ToString("F2")
            </span>
            @if (Product.OriginalPrice.HasValue)
            {
                <span class="text-xs text-kanto-muted line-through ml-1.5 font-semibold">
                    ₱@Product.OriginalPrice.Value.ToString("F2")
                </span>
            }
            <span class="block text-[10px] text-kanto-muted uppercase font-semibold">@Product.UnitDisplay</span>
        </div>

        <!-- Add to Cart Square Action Button (Matches inspo cart icon) -->
        <button @onclick="AddToCart"
                class="w-10 h-10 rounded-xl bg-kanto-cream-100 group-hover:bg-kanto-orange-500 text-kanto-green-900 group-hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm active:scale-95"
                title="Idagdag sa basket">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
        </button>
    </div>

</div>

@code {
    [Parameter, EditorRequired] public ProductItem Product { get; set; } = default!;
    private bool IsFavorited = false;

    private void ToggleWishlist()
    {
        IsFavorited = !IsFavorited;
    }

    private void AddToCart()
    {
        var sauce = Product.AvailableSauces.FirstOrDefault() ?? "Default";
        CartState.AddItem(Product, 1, sauce);
    }
}