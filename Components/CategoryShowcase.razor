@inject NavigationManager Nav

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" id="categories">
    <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-kanto-charcoal tracking-tight">
            Pumili Ayon sa Kategorya
        </h2>
        <p class="text-sm text-kanto-muted mt-1">
            Mula sa paboritong pampalipas-gutom hanggang sa ulam pampamilya
        </p>
    </div>

    <!-- Category Grid with Direct Routes -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        @foreach (var cat in CategoryTiles)
        {
            <a href="@cat.RouteUrl"
               class="group bg-white rounded-2xl p-4 border border-kanto-cream-200 shadow-soft-card hover:shadow-elevated transition-all duration-300 transform hover:-translate-y-1 block text-center">
                
                <!-- Accurate Category Image Frame -->
                <div class="w-full aspect-square rounded-xl overflow-hidden bg-kanto-cream-100 mb-4 relative shadow-inner">
                    <img src="@cat.ImageUrl" 
                         alt="@cat.Title" 
                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                    <div class="absolute inset-0 bg-kanto-green-950/10 group-hover:bg-transparent transition-colors"></div>
                </div>

                <!-- Text & Action Link -->
                <h3 class="font-bold text-sm sm:text-base text-kanto-charcoal group-hover:text-kanto-orange-500 transition-colors">
                    @cat.Title
                </h3>
                
                <span class="text-xs text-kanto-muted mt-1 flex items-center justify-center gap-1 font-semibold group-hover:text-kanto-orange-500 transition-colors">
                    <span>Buksan ang Menu</span>
                    <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </span>
            </a>
        }
    </div>
</section>

