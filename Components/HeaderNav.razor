@inject CartStateService CartState
@implements IDisposable

<header class="bg-white/95 backdrop-blur-sm sticky top-0 z-40 border-b border-kanto-cream-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
            <div class="w-11 h-11 rounded-xl bg-kanto-orange-500 flex items-center justify-center text-white shadow-md shadow-kanto-orange-500/20 group-hover:scale-105 transition-transform">
                <!-- Skewer / Streetfood Cart Bag Icon -->
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            </div>
            <div>
                <span class="text-2xl font-black tracking-tight text-kanto-green-900 block leading-tight">
                    Kanto<span class="text-kanto-orange-500">Cart</span>
                </span>
                <span class="text-[10px] tracking-wider text-kanto-muted uppercase font-semibold block -mt-0.5">
                    Lutong Kanto • Hatid sa Pinto
                </span>
            </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-kanto-charcoal">
            <a href="/tusok-tusok" class="hover:text-kanto-orange-500 transition-colors">Tusok-Tusok</a>
            <a href="/carinderia" class="hover:text-kanto-orange-500 transition-colors">Carinderia Ulam</a>
            <a href="/merienda" class="hover:text-kanto-orange-500 transition-colors">Merienda &amp; Palamig</a>
            <a href="/sari-sari" class="hover:text-kanto-orange-500 transition-colors">Sari-Sari Store</a>
            <a href="/#sulit-deals" class="text-kanto-orange-600 flex items-center gap-1 font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-kanto-orange-500 animate-pulse"></span>
                Sulit Deals
            </a>
        </nav>

        <!-- Right Action Strip: Cart Badge & Primary CTA -->
        <div class="flex items-center gap-4">
            
            <!-- Shopping Cart Pill Trigger -->
            <button @onclick="CartState.ToggleCart" 
                    class="relative p-2.5 rounded-full hover:bg-kanto-cream-100 text-kanto-green-900 transition-colors"
                    aria-label="Shopping Cart">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                @if (CartState.TotalItemCount > 0)
                {
                    <span class="absolute -top-1 -right-1 bg-kanto-orange-500 text-white font-bold text-xs w-5 h-5 rounded-full flex items-center justify-center animate-bounce">
                        @CartState.TotalItemCount
                    </span>
                }
            </button>

            <!-- Primary Action Button (Matches the orange 'SHOP NOW' button) -->
            <a href="#menu-explorer" 
               class="bg-kanto-orange-500 hover:bg-kanto-orange-600 text-white font-bold text-sm px-6 py-3 rounded-lg shadow-md shadow-kanto-orange-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0">
                PUNTA SA KANTO
            </a>

        </div>

    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        CartState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CartState.OnChange -= StateHasChanged;
    }
}